{% extends 'base.twig' %}

{% block content %}
<main>
    <h1>Promociones</h1>

    {% if context.promotions|default([])|length == 0 %}
        <p>No hay promociones disponibles en este momento.</p>
    {% else %}
        <ul class="promotions-lista">
            {% for promotion in context.promotions %}
                <li>
                    <article class="promotion-item">
                        <figure>
                            <picture>
                                {% for source in promotion.responsiveImage.sources|default([]) %}
                                    <source
                                        srcset="resources/images/{{ source.url }}"
                                        media="(max-width: {{ source.maxWidth }}px)"
                                    >
                                {% endfor %}
                                <img
                                    src="resources/images/{{ promotion.responsiveImage.fallbackSrc|default('') }}"
                                    alt="{{ promotion.description }}"
                                >
                            </picture>
                        </figure>
                        <p>{{ promotion.description }}</p>
                    </article>
                    <hr>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</main>
{% endblock %}

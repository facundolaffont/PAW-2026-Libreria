{#
    Variables esperadas:
    - title: string (definida en View::render()).
    - page: string (definida en View::render()).
    - context.page: string (definida en ContextBuilder->build()).
#}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title|default('PAWPrints') }}</title>

    <link rel="stylesheet" href="resources/styles/reset.css">
    <link rel="stylesheet" href="resources/styles/base.css">
    {% if page is defined and page is not empty %}
        <link rel="stylesheet" href="resources/styles/{{ page }}.css">
    {% endif %}

    <script src="resources/js/app.js"></script>
</head>
<body{% if context.page is defined %} data-page="{{ context.page }}"{% endif %}>
    {% block header %}
        {% include 'components/header.twig' %}
    {% endblock %}

    {% block content %}{% endblock %}

    {% block footer %}
        {% include 'components/footer.twig' %}
    {% endblock %}

    {% block scripts %}{% endblock %}
</body>
</html>

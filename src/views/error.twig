{% extends 'base.twig' %}

{#
    Variables esperadas:
    - context.httpCode: int (definida en ErrorHandler->handleHttpError).
    - context.clientMessage: string (definida en ErrorHandler->handleHttpError).
#}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<main>
    <h1>{{ context.httpCode }}</h1>
    <p>{{ context.clientMessage }}</p>
    <a href="/">Volver al inicio</a>
</main>
{% endblock %}

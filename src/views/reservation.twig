{% extends 'base.twig' %}

{#
    Variables esperadas:
    - context.query.enviada: string (definida en el render de la vista).
    - context.errors.general: string (definida en el render de la vista).
    - context.errors.nombre: string (definida en el render de la vista).
    - context.errors.email: string (definida en el render de la vista).
    - context.errors.telefono: string (definida en el render de la vista).
    - context.nombre: string (definida en el render de la vista).
    - context.email: string (definida en el render de la vista).
    - context.telefono: string (definida en el render de la vista).
#}

{% block content %}
<main>
    <nav aria-label="Migas de pan">
        <ol>
            <li><a href="#">Reserva de libros</a></li>
        </ol>
    </nav>

    <h1>Mi reserva</h1>

    {% if context.query.enviada|default('') == '1' %}
        <div class="alerta alerta-exito" role="alert">
            <p>¡Tu reserva fue enviada con éxito! Nos comunicaremos contigo a la brevedad.</p>
        </div>
    {% endif %}

    {% if context.errors.general|default('') %}
        <div class="alerta alerta-error" role="alert">
            <p>{{ context.errors.general }}</p>
        </div>
    {% endif %}

    <section>
        <h2>Libros seleccionados</h2>

        <p id="reservation-vacia" class="reservation-vacia" hidden>
            Tu reserva está vacía. Agregá libros desde el <a href="catalog">catálogo</a>.
        </p>

        <ul id="reservation-lista" aria-live="polite"></ul>

        <p id="reservation-total" class="reservation-total" hidden>
            <span>Total:</span>
            <span class="reservation-total-valor">$ 0,00</span>
        </p>
    </section>

    <section>
        <h2>Datos personales</h2>

        <form
            id="reservation-form"
            action="/reservation"
            method="post"
            enctype="application/x-www-form-urlencoded"
        >
            <div id="reservation-libros-hidden"></div>

            <div>
                <label for="nombre">Nombre completo</label>
                <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    placeholder="Ej: Juan Garcia"
                    required
                    minlength="2"
                    maxlength="100"
                    pattern="[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+"
                    value="{{ context.nombre|default('') }}"
                    aria-describedby="nombre-error"
                    {% if context.errors.nombre|default('') %}aria-invalid="true"{% endif %}
                >
                {% if context.errors.nombre|default('') %}
                    <span id="nombre-error" class="campo-error" role="alert">{{ context.errors.nombre }}</span>
                {% endif %}
            </div>

            <div>
                <label for="email">Email</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Ej: mi_correo@gmail.com"
                    required
                    maxlength="254"
                    value="{{ context.email|default('') }}"
                    aria-describedby="email-error"
                    {% if context.errors.email|default('') %}aria-invalid="true"{% endif %}
                >
                {% if context.errors.email|default('') %}
                    <span id="email-error" class="campo-error" role="alert">{{ context.errors.email }}</span>
                {% endif %}
            </div>

            <div>
                <label for="telefono">Teléfono</label>
                <input
                    type="tel"
                    id="telefono"
                    name="telefono"
                    placeholder="Ej: 1126660206"
                    required
                    minlength="8"
                    maxlength="20"
                    pattern="[0-9+\-\s]+"
                    value="{{ context.telefono|default('') }}"
                    aria-describedby="telefono-error"
                    {% if context.errors.telefono|default('') %}aria-invalid="true"{% endif %}
                >
                {% if context.errors.telefono|default('') %}
                    <span id="telefono-error" class="campo-error" role="alert">{{ context.errors.telefono }}</span>
                {% endif %}
            </div>

            <button type="submit" id="reservation-confirmar">Confirmar reserva</button>
        </form>
    </section>
</main>
{% endblock %}
